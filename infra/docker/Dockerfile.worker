# syntax=docker/dockerfile:1.7
# Workers share the API image's dependency set; only the entrypoint differs.
FROM python:3.12-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

FROM base AS development
COPY requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app
# The opt-in workers profile mounts code and supplies the process-specific DSN.
CMD ["python", "-m", "workers.outbox_relay"]

FROM base AS production
COPY --chown=1000:1000 apps ./apps
COPY --chown=1000:1000 packages ./packages
COPY --chown=1000:1000 workers ./workers
RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app
CMD ["python", "-m", "workers.outbox_relay"]
