{
  "name": "jobforge-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:types": "openapi-typescript http://localhost:8000/openapi.json -o types/api.ts",
    "audit:colors": "node scripts/audit-colors.mjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "10.4.20",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.4",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.11"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
