# ---------------------------------------------------------------------------
# Jobforge - local environment template
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. No real secret belongs in
# this file (SECURITY.md §3.3). The values below are local-development
# placeholders only; production secrets come from AWS Secrets Manager.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_NAME=jobforge
ENVIRONMENT=local              # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console | json

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
WEB_PORT=3000

# --- postgres --------------------------------------------------------------
POSTGRES_HOST=localhost        # docker compose overrides this to "postgres"
POSTGRES_PORT=5432
POSTGRES_USER=jobforge
POSTGRES_PASSWORD=localdev     # local placeholder - change for anything shared
POSTGRES_DB=jobforge
# DATABASE_URL=                # optional: overrides the parts above
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- database roles (least privilege, DATABASE_DESIGN.md §8) --------------
# Local placeholders only. The security tests connect as app_agent to prove
# it cannot write profile facts, so these must be set for `make test-security`.
APP_API_PASSWORD=app_api
APP_AGENT_PASSWORD=app_agent
APP_MONITOR_PASSWORD=app_monitor
APP_MIGRATE_PASSWORD=app_migrate

# --- redis -----------------------------------------------------------------
REDIS_HOST=localhost           # docker compose overrides this to "redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=                   # optional: overrides the parts above

# --- object storage (MinIO locally, S3 in production) ----------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=jobforge-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# --- Claude / LLM ----------------------------------------------------------
# Leave empty until you actually need live calls. Tests run in replay mode
# against recorded cassettes and never touch the network.
ANTHROPIC_API_KEY=
LLM_MODE=replay                # replay | record | live
LLM_MAX_COST_USD_PER_RUN=1.00

# --- safety limits ---------------------------------------------------------
# These are operational limits. The anti-fabrication guardrails in
# SECURITY.md §4 are deliberately NOT configurable and appear nowhere here.
SUBMISSION_MODE=dry_run        # dry_run | enabled  (enabled also requires the UI toggle)
DAILY_APPLICATION_QUOTA=100
DAILY_EVALUATION_QUOTA=600
DAILY_LLM_COST_BUDGET_USD=25.00
FIT_SCORE_SHORTLIST_THRESHOLD=65
FIT_SCORE_REVIEW_FLOOR=55

# --- session ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=720

# --- frontend (NEXT_PUBLIC_* values reach the browser - nothing secret) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME=Jobforge

# --- authentication ----------------------------------------------------
# 32 random bytes, base64. Generate with:
#   docker compose run --rm api python -m scripts.setup_demo_auth --generate-key
# Never commit a real value.
TOTP_ENCRYPTION_KEY=
SESSION_SECRET=

# Explicit prices for LLM_MODEL_TAILORING, required for C3 live/record calls.
# LLM_TAILORING_INPUT_PRICE_PER_MILLION=
# LLM_TAILORING_OUTPUT_PRICE_PER_MILLION=
