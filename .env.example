# ---------------------------------------------------------------------------
# Jobforge - local environment template
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. No real secret belongs in
# this file (SECURITY.md §3.3). The values below are local-development
# placeholders only; production secrets come from AWS Secrets Manager.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_NAME=jobforge
ENVIRONMENT=local              # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console | json

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
WEB_PORT=3000

# --- postgres --------------------------------------------------------------
POSTGRES_HOST=localhost        # docker compose overrides this to "postgres"
POSTGRES_PORT=5432
POSTGRES_USER=jobforge
POSTGRES_PASSWORD=localdev     # local placeholder - change for anything shared
POSTGRES_DB=jobforge
# DATABASE_URL=                # optional: overrides the parts above
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- database roles (least privilege, DATABASE_DESIGN.md §8) --------------
# Local placeholders only. The security tests connect as app_agent to prove
# it cannot write profile facts, so these must be set for `make test-security`.
APP_API_PASSWORD=app_api
APP_AGENT_PASSWORD=app_agent
APP_MONITOR_PASSWORD=app_monitor
APP_MIGRATE_PASSWORD=app_migrate
# Added by 0005: the inference-audit role (C3 hardening I.6).
APP_AUDIT_PASSWORD=app_audit

# Batch 3A. The connection the audit boundary writes with. Set this and audit
# rows are written by the least-privileged `app_audit` role, which can insert
# into agent_runs / agent_run_steps / llm_calls / events and nothing else.
#
# LEAVE IT UNSET and the boundary still runs - on its own engine, its own
# connection and its own transaction, against the domain DSN. Audit writes
# still survive a domain rollback, which is the property Batch 3A is for; what
# you lose is privilege separation, and the app says so once at startup. The
# privilege tests skip when it is unset rather than passing as app_api.
# AUDIT_DATABASE_URL=postgresql+asyncpg://app_audit:app_audit@localhost:5432/jobforge

# --- redis -----------------------------------------------------------------
REDIS_HOST=localhost           # docker compose overrides this to "redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=                   # optional: overrides the parts above

# --- object storage (MinIO locally, S3 in production) ----------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=jobforge-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# --- email delivery (M11 Phase 1) -------------------------------------------
# EMAIL_TRANSPORT_MODE selects the implementation only; it never authorises a
# real send by itself (SUBMISSION_MODE + the persisted submission_enabled
# switch do that - see the "safety limits" section below). "fake" is the
# default and never opens a network socket. "smtp" targets the docker-compose
# `mailhog` service locally (profile "full"); username/password are optional
# for MailHog and required for a real relay.
EMAIL_TRANSPORT_MODE=fake      # fake | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Claude / LLM ----------------------------------------------------------
# Leave empty until you actually need live calls. Tests run in replay mode
# against recorded cassettes and never touch the network. Staging/production
# require it only when LLM_MODE is record or live; replay needs no key.
ANTHROPIC_API_KEY=
LLM_MODE=replay                # replay | record | live
LLM_MAX_COST_USD_PER_RUN=1.00

# --- safety limits ---------------------------------------------------------
# These are operational limits. The anti-fabrication guardrails in
# SECURITY.md §4 are deliberately NOT configurable and appear nowhere here.
SUBMISSION_MODE=dry_run        # dry_run | enabled  (enabled also requires the UI toggle)
DAILY_APPLICATION_QUOTA=100
DAILY_EVALUATION_QUOTA=600
DAILY_LLM_COST_BUDGET_USD=25.00
FIT_SCORE_SHORTLIST_THRESHOLD=65
FIT_SCORE_REVIEW_FLOOR=55

# --- Operational monitoring (M12 Phase 2) -----------------------------------
# Detection thresholds only. No value here can pause generation, start a
# submission, or resolve a human-only alert.
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
MONITOR_HEARTBEAT_MISSING_SECONDS=90      # must be >= 2 x heartbeat interval
MONITOR_SUBMISSION_FAILURE_WINDOW=10      # also the minimum sample size
MONITOR_SUBMISSION_FAILURE_RATE=0.30      # spike iff failures / window > rate
MONITOR_STALL_SECONDS=86400
MONITOR_APPROVAL_BACKLOG=30
MONITOR_CONSUMER_LAG=500
MONITOR_CONSUMER_LAG_SUSTAINED_SECONDS=600
MONITOR_STALE_TICK_SECONDS=900

# --- session ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=720

# --- frontend (NEXT_PUBLIC_* values reach the browser - nothing secret) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME=Jobforge

# --- authentication ----------------------------------------------------
# 32 random bytes, base64. Generate with:
#   docker compose run --rm api python -m scripts.setup_demo_auth --generate-key
# Never commit a real value. Required in staging/production: startup fails
# if it is missing, blank, not strict base64, or not exactly 32 bytes.
TOTP_ENCRYPTION_KEY=
SESSION_SECRET=

# Explicit prices for LLM_MODEL_TAILORING, required for C3 live/record calls.
# LLM_TAILORING_INPUT_PRICE_PER_MILLION=
# LLM_TAILORING_OUTPUT_PRICE_PER_MILLION=

# --- opt-in workers profile (M4) --------------------------------------------
# Explicit async PostgreSQL DSNs with URL-encoded passwords. In Compose use
# host postgres; the relay requires app_agent and monitor/scheduler app_monitor.
# No privileged DATABASE_URL fallback. Leave blank until deliberately enabled.
WORKER_AGENT_DATABASE_URL=
WORKER_MONITOR_DATABASE_URL=

# Optional explicit candidate for optimizer; otherwise exactly one owner profile is required.
WORKER_PROFILE_ID=
